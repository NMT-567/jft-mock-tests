# .env.example
#
# IMPORTANT — read this before copying values anywhere:
#
# This is a static site (no build step, no server, no .env loader) —
# nothing in this repo actually READS a .env file. This file exists
# purely as a reference for where each value belongs. See
# SETUP_SUPABASE_AUTH.md for the full walkthrough.

# ---------------------------------------------------------------------
# These two are PUBLIC and belong in js/config.js (committed to git).
# They are safe to expose — Postgres Row Level Security is what
# actually protects data, not secrecy of these values.
# ---------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---------------------------------------------------------------------
# These belong ONLY in the Supabase dashboard
# (Authentication → Providers → Google) — NEVER in this repo, in any
# file, in any commit, ever. Supabase stores them server-side and uses
# them to complete the OAuth exchange; the frontend never sees them.
# ---------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------
# This belongs ONLY inside Supabase Edge Functions (auto-injected by
# Supabase at runtime — you never type it in anywhere). NEVER in this
# repo. Used by supabase/functions/submit-attempt and
# supabase/functions/admin-revoke-session — nowhere else.
# ---------------------------------------------------------------------
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------
# Sanity check before every commit:
#   git grep -i "service_role" -- . ':!supabase/functions'
#   git grep -i "client_secret"
# Both should return nothing.
# ---------------------------------------------------------------------
